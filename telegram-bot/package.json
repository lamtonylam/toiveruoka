{
  "name": "toiveruoka-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram bot for Unicafe favorite food subscriptions and daily notifications",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "prisma db push && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "npx prisma generate && tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@grammyjs/menu": "^1.3.0",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
