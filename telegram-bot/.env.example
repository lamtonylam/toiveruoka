# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Backend API address (in docker compose dev: http://backend:3000, locally: http://localhost:3000)
BACKEND_URL=http://backend:3000

# PostgreSQL connection string
# When running with docker-compose-dev:
DATABASE_URL=postgres://toiveruoka:toiveruoka_password@postgres:5432/toiveruoka
# When running locally without docker:
# DATABASE_URL=postgres://toiveruoka:toiveruoka_password@localhost:5432/toiveruoka

# Cron configuration
CRON_SCHEDULE=0 10 * * *
TIMEZONE=Europe/Helsinki
